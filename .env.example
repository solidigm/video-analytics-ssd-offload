# ============================================================
# Sports Analytics Platform - Environment Variables
# Copy to .env and fill in secrets before running:
#   cp .env.example .env && nano .env
# ============================================================

# === Secrets (REQUIRED — fill these in) ===
HF_TOKEN=your_huggingface_token_here
POSTGRES_PASSWORD=postgres
GRAFANA_PASSWORD=admin123

# === Model Configuration ===
# LLM used for game analysis & chat (GPU 0 = LMCache, GPU 1 = Baseline)
LLM_MODEL=aws-prototyping/MegaBeam-Mistral-7B-300k
# VLM used for video frame analysis (GPU 2)
VLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Thinking

# === vLLM Service URLs (Docker internal) ===
LLM_LMCACHE_URL=http://vllm-lmcache:8000/v1
LLM_BASELINE_URL=http://vllm-baseline:8000/v1
VLM_API_URL=http://vllm-vlm:8000/v1

# === Database ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=sports_analytics
# DATABASE_URL is constructed automatically in docker-compose:
# postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@postgres:5432/sports_analytics

# === Data Paths (inside container) ===
DATA_PATH=/data
VIDEO_UPLOAD_PATH=/data/videos
FRAMES_PATH=/data/frames
ANALYSIS_PATH=/data/analysis
LOGS_PATH=/logs

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8000

# === Frontend ===
FRONTEND_PORT=3000
VITE_API_BASE_URL=

# === Monitoring ===
# Prometheus is Docker-internal only (no host port exposed)
# Must include /prometheus prefix to match --web.route-prefix in docker-compose
PROMETHEUS_URL=http://prometheus:9090/prometheus
# node-exporter runs in Docker network (no host port) — accessed via Docker DNS
NODE_EXPORTER_URL=http://host.docker.internal:9100

# === LMCache / KV Cache Offload ===
# SSD_DEVICE: kernel device name of the Solidigm NVMe (used by metrics + benchmark)
# Run `lsblk` to find yours — typically nvme0n1, nvme1n1, etc.
SSD_DEVICE=nvme0n1
LMCACHE_ENABLED=true
LMCACHE_BACKEND=solidigm
LMCACHE_CONFIG_FILE=/app/configs/lmcache_config.yaml
KV_CACHE_PATH=/mnt/ssd/kv_cache
KV_CACHE_SIZE_GB=100

# === Video Pipeline ===
FRAME_INTERVAL_SECONDS=5
CHUNK_DURATION_MINUTES=5
MAX_FRAMES_PER_CHUNK=60
TEMP_FRAMES_DIR=/tmp/video_frames

# === Cache Seeding & Flush Tuning ===
AUTO_SEED_ON_STARTUP=true
VLLM_HEALTH_POLL_INTERVAL=30
MAX_FLUSH_CHARS=780000
MIN_FLUSH_CHARS=120000
FLUSH_INPUT_TOKEN_BUDGET=190000
FLUSH_MAX_ATTEMPTS=6
FLUSH_SAFE_CHARS=680000
BASELINE_READY_TIMEOUT_SECONDS=180

# === Multi-User Benchmark ===
# Auto-populated by setup_quick.sh based on the deployment directory
MULTI_USER_MAX_CONTEXT_CHARS=220000
BENCHMARK_HOST_DATA_DIR=/path/to/deployment/data
K6_DOCKER_IMAGE=soln-k6-sse
K6_DOCKER_NETWORK=solidigm-phase3_default
# Max runtime for the overall k6 scenario (safety ceiling).
BENCHMARK_MAX_DURATION=172800s
# Per-request SSE timeout used by each virtual user stream.
BENCHMARK_SSE_TIMEOUT=900s
# Watchdog grace: stop k6 if all requests are terminal but process is still stuck.
BENCHMARK_TERMINAL_GRACE_SECONDS=20

# === GPU Configuration ===
NVIDIA_VISIBLE_DEVICES=all

# === OpenTelemetry (optional) ===
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=american_football-analytics-agent
# OTEL_CONSOLE_EXPORT=false
# OTEL_FILE_EXPORT=true
# OTEL_OUTPUT_DIR=telemetry_output

# === External APIs (optional) ===
# TAVILY_API_KEY=your_tavily_api_key_here
